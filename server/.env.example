# Server Port
PORT=7002

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bharatshoppy?retryWrites=true&w=majority

# Client Application URL
CLIENT_URL=http://localhost:5173

# Required Authentication Secret for Session & Token Signing (Leave blank in example, set securely in environment)
AUTH_SECRET=

# Gmail SMTP Service Credentials for 2FA & Login Codes
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Admin Account Configuration
ADMIN_EMAIL=admin@bharatshopy.com
ADMIN_PASSWORD=change-this-password-locally

# Seeding Guard (requires true in development to allow seeding)
ALLOW_SEED=false

# Cloudinary Storage Configuration for Product Photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Cron Secret for Automated 7-Day Vendor Removal Cleanup
CRON_SECRET=
